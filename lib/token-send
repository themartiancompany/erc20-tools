_contract_run =
  _evm_contracts_tools_module._contract_run;
const
  _erc20_contracts_module =
    require(
      "erc20-contracts");
/* global
     _data_get */
_data_get =
  _erc20_contracts_module._data_get;

function
  _global_variables() {
  /* global
       app_name:
         writable */
  app_name =
    "token-send";
  /* global
       retries_max:
         writable */
  retries_max =
    "";
  /* global
       call_timeout:
         writable */
  call_timeout =
    "";
  /* global
       wallet_seed_path:
         writable */
  wallet_seed_path =
    "";
  /* global
       api_key_path:
         writable */
  api_key_path =
    "";
  /* global
       target_network:
         writable */
  target_network =
    "";
  /* global
       token_address:
         writable */
  token_address =
    "";
  /* global
       token_abi_path:
         writable */
  token_abi_path =
    "";
  /* global
       token_bytecode_path:
         writable */
  token_bytecode_path =
    "";
  /* global
       token_compiler_output_path:
         writable */
  token_compiler_output_path =
    "";
  /* global
       measure_unit:
         writable */
  measure_unit =
    "";
  /* global
       target_recipient:
         writable */
  target_recipient =
    "";
  /* global
       target_amount:
         writable */
  target_amount =
    "";
  /* global
       receipt_file_path:
         writable */
  receipt_file_path =
    "";
  /* global
       quiet:
         writable */
  quiet =
    "";
}

async function
  _token_send_call(
    _contract_run_opts) {
  let
    _tx;
  try {
    _tx = await
      _contract_run.apply(
        null,
        _contract_run_opts);
  } catch(
      _error) {
    const
      _msg =
        "Error sending the amount.";
    _error_display(
      _error);
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  return _tx;
}

function
  _ether_to_wei(
    _amount) {
  return _parse_units(
    _amount,
    "ether");
}

async function
  _token_send(
    _retries_max,
    _call_timeout,
    _wallet_seed_path,
    _api_key_path,
    _target_network,
    _token_address,
    _token_abi_path,
    _token_bytecode_path,
    _token_compiler_output_path,
    _measure_unit,
    _receipt_file_path,
    _target_recipient,
    _amount
  ) {
  let
    _msg,
    _receipt,
    _receipt_json,
    _token_send_call_base_opts,
    _token_send_call_opts,
    _transfer_args,
    _wallet_password;
  if ( typeof(
         _token_abi_path) == "undefined" ||
       _token_abi_path == "" ) {
    _token_abi_path =
      _data_get(
        "Token",
        "abi",
        "path");
  }
  if ( typeof(
         _token_bytecode_path) == "undefined" ||
       _token_bytecode_path == "" ) {
    _token_bytecode_path =
      _data_get(
        "Token",
        "bytecode",
        "path");
  }
  if ( typeof(
         _token_compiler_output_path) == "undefined" ||
       _token_compiler_output_path == "" ) {
    _token_compiler_output_path =
      _data_get(
        "Token",
        "compiler-output",
        "path");
  }
  if ( typeof(
         _amount) == "undefined" ||
       _amount == "" ) {
    _msg =
      "Amount must be a number greater than zero.";
    _msg_error(
      _msg,
      1);
  }
  if ( _receipt_file_path == undefined ) {
    _receipt_file_path =
      "";
  }
  if ( _call_timeout == "" ) {
    _call_timeout =
      300000;
  }
  _call_timeout =
    Number(
      _call_timeout);
 if ( _measure_unit == "ether" ) {
    _amount =
      _ether_to_wei(
        _amount);
  }
  _amount =
    Number(
      _amount);
  _wallet_password =
    "";
  _token_send_call_base_opts = [
    _retries_max,
    _call_timeout,
    _wallet_seed_path,
    _wallet_password,
    _api_key_path,
    "",
    0,
    "ether",
    _target_network,
    _token_address,
    _token_abi_path,
    _token_bytecode_path,
    _token_compiler_output_path,
    "transfer"
  ];
  _transfer_args = [
    _target_recipient,
    _amount
  ];
  _token_send_call_opts =
    _token_send_call_base_opts.concat(
      [_transfer_args]);
  try {
    _receipt = await
      _token_send_call(
        _token_send_call_opts);
  } catch (
      _error) {
    _error_display(
      _error);
    _msg =
      "Error sending the intended token amount.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  if ( _receipt_file_path != "" ) {
    _receipt_json =
      _json_display(
        _receipt);
    _file_write(
      _receipt_file_path,
      _receipt_json);
  }
  return _receipt;
}

function
  _config_show() {
  let
    _line;
  const
    _text = [
    `          Maximum retries: ${retries_max}`,
    `             Call timeout: ${call_timeout}`,
    `              Wallet seed: ${wallet_seed_path}`,
    `                  API Key: ${api_key_path}`,
    `           Target network: ${target_network}`,
    `            Token address: ${token_address}`,
    `                Token ABI: ${token_abi_path}`,
    `           Token bytecode: ${token_bytecode_path}`,
    `    Token compiler output: ${token_compiler_output_path}`,
    `             Measure unit: ${measure_unit}`,
    `        Receipt file path: ${receipt_file_path}`,
    `         Target recipient: ${target_recipient}`,
    `            Target amount: ${target_amount}`,
    ];
  for ( _line in _text ) {
    _msg_info(
      _text[
        _line]);
  }
}

function
  _usage(
    _exit_code) {
  let
    _line,
    _text;
  if ( typeof(
         _exit_code) == "undefined" ||
       _exit_code == "" ) {
    _exit_code =
      0;
  }
  const
    _argv =
      _argv_get();
  const
    _program =
      _basename(
        _argv[
          "$0"]);
  _text = [
    "Send ERC-20 tokens.",
    "",
    "Usage:",
    `  ${_program}`,
    "    <quiet>",
    "    <retries-max>",
    "    <call-timeout>",
    "    <wallet-seed-path>",
    "    <api-key-path>",
    "    <target-network>",
    "    <token-address>",
    "    <token-abi-path>",
    "    <token-bytecode-path>",
    "    <token-compiler-output-path>",
    "    <measure-unit>",
    "    <receipt-file-path>",
    "    <target-recipient>",
    "    <target-amount>",
    "",
    "Args:",
    "",
    "  <quiet>                          Can be 'y' or 'n'",
    `                                   Default: ${quiet}`,
    "",
    "  <retries-max>                    Maximum number of retries before",
    "                                   failing.",
    `                                   Default: ${retries_max}`,
    "",
    "  <call-timeout>                   How many milliseconds to wait for a return",
    "                                   before declaring the call failed.",
    `                                   Default: ${call_timeout}`,
    "",
    "  <wallet-seed-path>               Path of the file containing",
    "                                   the seed phrase.",
    `                                   Default: ${wallet_seed_path}`,
    "",
    "  <api-key-path>                   Path of the API key for the",
    "                                   contract ABI provider service.",
    "",
    "  <target-network>                 Network on which the contract",
    "                                   resides.",
    "",
    "  <token-address>                  Address of the token contract.",
    "",
    "  <token-abi-path>                 Token ABI path.",
    `                                   Default: ${token_abi_path}`,
    "",
    "  <token-bytecode-path>            Path for the token bytecode.",
    `                                   Default: ${token_bytecode_path}`,
    "",
    "  <token-compiler-output-path>     Path for the token compiler",
    "                                   output path (the hardhat artifact).",
    `                                   Default: ${token_compiler_output_path}`,
    "",
    "  <measure-unit>                   Measure unit for the transaction",
    "                                   value. It can be 'wei' or 'ether'",
    `                                   Default: ${measure_unit}`,
    "",
    "  <receipt-file-path>              If specified, will save the transaction",
    "                                   receipt at the path.",
    "",
    `  <target-amount>                  How much '${measure_unit}' of the specified`,
    "                                   token to send.",
  ];
  for ( _line of _text ) {
    console.log(
      _line);
  }
  process.exit(
    _exit_code);
}

function 
  _cmdline_parse() {
  let
    _msg;
  quiet = 
    "y";
  process.argv.forEach(
    function (
      _value,
      _index,
      _array) {
      if ( _index == 2 ) {
        quiet =
          _value;
      }
      if ( _index == 3 ) {
        retries_max =
          _value;
      }
      if ( _index == 4 ) {
        call_timeout =
          _value;
      }
      if ( _index == 5 ) {
        wallet_seed_path =
          _value;
      }
      if ( _index == 6 ) {
        api_key_path =
          _value;
      }
      if ( _index == 7 ) {
        target_network =
          _value;
      }
      if ( _index == 8 ) {
        token_address =
          _value;
      }
      if ( _index == 9 ) {
        token_abi_path =
          _value;
      }
      if ( _index == 10 ) {
        token_bytecode_path =
          _value;
      }
      if ( _index == 11 ) {
        token_compiler_output_path =
          _value;
      }
      if ( _index == 12 ) {
        measure_unit =
          _value;
      }
      if ( _index == 13 ) {
        receipt_file_path =
          _value;
      }
      if ( _index == 14 ) {
        target_recipient =
          _value;
      }
      if ( _index == 15 ) {
        target_amount =
          _value;
      }
      if ( _value == "-h" ||
           _value == "--help" ) {
        _overrides_set();
        quiet =
          "n";
        _usage(
          0);
      }
  });
  if ( target_recipient == "" ) {
    _overrides_set();
    quiet =
      "n";
    _msg =
       "No input recipient.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
  if ( token_address == "" ) {
    _overrides_set();
    quiet =
      "n";
    _msg =
       "No token address specified.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
  if ( target_amount == "" ) {
    quiet =
      "n";
    _msg =
       "No amount specified.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
  if ( target_amount == "0" ||
       target_amount == 0 ) {
    _overrides_set();
    quiet =
      "n";
    _msg =
       "Amount specified is zero.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
}

async function
  _token_send_cmdline(
    _app_opts) {
  let
    _msg,
    _receipt;
  try {
    _receipt =
      await _token_send.apply(
        null,
        _app_opts);
    if (  _receipt == undefined ) {
      _msg =
        "Error sending the amount.";
      throw { "error": {
                "message":
                  _msg} };
    }
    console.log(
      _receipt);
  } catch (
      _error) {
    _msg =
      "Transfer error.";
    _error_display(
      _error);
    _msg_error(
      _msg,
      1);
  }
}

function
  _overrides_set() {
  if ( typeof(
         token_abi_path) == "undefined" ||
       token_abi_path == "" ) {
    token_abi_path =
      _data_get(
        "Token",
        "abi",
        "path");
  }
  if ( typeof(
         token_bytecode_path) == "undefined" ||
       token_bytecode_path == "" ) {
    token_bytecode_path =
      _data_get(
        "Token",
        "bytecode",
        "path");
  }
  if ( typeof(
         token_compiler_output_path) == "undefined" ||
       token_compiler_output_path == "" ) {
    token_compiler_output_path =
      _data_get(
        "Token",
        "compiler-output",
        "path");
  }
  if ( typeof(
         call_timeout) == "undefined" ||
       call_timeout == "" ) {
    call_timeout =
      300000;
  }
  if ( typeof(
         measure_unit) == "undefined" ||
       measure_unit == "" ) {
    measure_unit =
      "ether";
  }
}

if ( _cmdline_check(
       "token-send") == true ||
     _cmdline_check(
       "erc20-token-send") == true ) {
  _global_variables();
  _cmdline_parse();
  _overrides_set();
  _config_show();
  app_opts = [
    retries_max,
    call_timeout,
    wallet_seed_path,
    api_key_path,
    target_network,
    token_address,
    token_abi_path,
    token_bytecode_path,
    token_compiler_output_path,
    measure_unit,
    receipt_file_path,
    target_recipient,
    target_amount,
  ];
  _token_send_cmdline(
    app_opts);
}

module.exports = {
  _token_send:
    _token_send
};

{ "name": "erc20-tools",
  "version":
    "0.0.20",
  "description":
    "JavaScript programs and libraries to enable seamless development of native computer applications designed to interact with Ethereum *RC-20 tokens (ERC-20, BRC-20, etc.) on Ethereum Virtual Machine-compatible networks.",
  "funding": {
    "type":
      "patreon",
    "url":
      "https://patreon.com/tallero"
  },
  "man": [
    "./man/evm-contract-call-dynamic.1"
  ],
  "files": [
    "AUTHORS.rst",
    "COPYING",
    "README.md",
    "dist",
    "erc20-tools",
    "fs-worker.webpack.config.js",
    "lib",
    "package.json",
    "serve.json",
    "webpack.config.js"
  ],
  "keywords": [
    "ur",
    "themartiancompany",
    "dogeos",
    "ethereum",
    "evmfs"
  ],
  "homepage":
    "https://github.com/themartiancompany/erc20-tools",
  "bugs": {
    "url":
      "https://github.com/themartiancompany/erc20-tools/issues"
  },
  "repository": {
    "type":
      "git",
    "url":
      "git+https://github.com/themartiancompany/erc20-tools.git"
  },
  "license":
    "AGPL-3.0-or-later",
  "author": {
    "name":
      "Pellegrino Prevete",
    "email":
      "pellegrinoprevete@gmail.com",
    "url":
      "https://github.com/tallero"
  },
  "devDependencies": {
    "crash-js-webpack":
      "^0.0.64",
    "flatted":
      "^3.2.9",
    "eslint":
      "^10.9.0",
    "globals":
      "^17.3.0",
    "@eslint/js":
      "^10.0.1",
    "safely-serve":
      "^0.0.18",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^100000001.1000000000000001.1000000000000001",
    "ethers":
      "^6.13.2",
    "erc20-contracts":
      "^0.0.6",
    "evm-contracts-tools":
      "^0.0.52",
    "libevm":
      "^0.0.37",
    "ws":
      "^8.21.0",
    "yargs":
      "18.0.0"
  },
  "overrides": {
    "erc20-tools":
      "./erc20-tools"
  },
  "type":
    "module",
  "main":
    "erc20-tools",
  "bin":
    { 
      "token-send":
        "lib/token-send",
      "erc20-token-send":
        "lib/token-send" },
  "scripts": {
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details && mv 'fs-worker.js' 'dist/erc20-tools'",
    "build-lib":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details && mv 'erc20-tools.js' 'dist/erc20-tools'",
    "build":
      "npm run lint && npm run build-fs-worker && npm run build-lib",
    "lint":
      "npx eslint .",
    "publish-npm":
      "npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/erc20-tools'",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
